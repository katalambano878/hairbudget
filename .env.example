# HairBudget — plain Postgres (no Supabase keys in the browser)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3005
NEXT_PUBLIC_USE_PLAIN_PG=true

# Postgres — Coolify / VPS uses the PgBouncer URL from fleet
# DATABASE_URL=postgresql://store_hairbudget:***@fleet-pgbouncer:6432/store_hairbudget
# DIRECT_URL=postgresql://store_hairbudget:***@fleet-postgres:5432/store_hairbudget
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# JWT sessions (long random string). Do not reuse a public value.
AUTH_JWT_SECRET=

# Optional email / payments
RESEND_API_KEY=
ADMIN_EMAIL=info@hairbudgetgh.com
EMAIL_FROM=HairBudget <noreply@hairbudgetgh.com>
CRON_SECRET=

# Uploads on VPS disk (optional; binary objects also go in storage_objects)
UPLOAD_DIR=
